{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Dead-code detection for the whole workspace. ESLint sees one file at a
  // time, so it catches an unused local and nothing else; knip resolves the
  // whole import graph and answers the question ESLint cannot: is anything
  // still reaching this?
  //
  // `pnpm knip` is exactly what CI runs, so a green run locally means a green
  // run there. `pnpm knip:all` remains as a backwards-compatible alias for the
  // same full check.

  // APP_STORE_URL is deliberately public before its /get chooser exists. Keep
  // that one exception on the symbol instead of masking every export in its file.
  "tags": ["-knipignore"],

  "ignoreIssues": {
    // Generated by `pnpm db:gen:types`. Supabase exports the whole schema even
    // when the app does not currently read every helper or table shape.
    "packages/shared/src/database.types.ts": ["exports", "types"]
  },

  "rules": {
    // Equal exported values can be an intentional public API. GET_APP_URL is
    // one such seam: it can become a chooser page without changing its callers.
    "duplicates": "off"
  },

  "workspaces": {
    ".": {
      // Deployed to Supabase and invoked by the trg_push_notification pg_net
      // trigger, so nothing in this repo imports it. Without this line it
      // reads as a dead file (see supabase/config.toml).
      "entry": ["supabase/functions/**/index.ts"],

      // That function is Deno, where a dependency is written inline as
      // `npm:@supabase/supabase-js@2`. knip resolves the specifier to a
      // package literally named "npm". There is nothing to declare: Deno
      // fetches it at deploy time, and this repo's package.json has no say.
      "ignoreDependencies": ["npm"],

      // The `appstore:*` scripts shell out to the EAS CLI, which is installed
      // globally and authenticated per machine rather than per checkout.
      // Declaring eas-cli here would pin a build tool nothing imports into
      // every install, including CI, which never runs those scripts.
      "ignoreBinaries": ["eas"]
    },

    "apps/mobile": {
      // Metro picks these by platform, not by import: `./glyphFallback`
      // resolves to `glyphFallback.ios.tsx` on iOS and `glyphFallback.tsx`
      // everywhere else. knip only follows the import graph, so the platform
      // variant reads as a dead file. Listing it as an entry keeps it analysed
      // (its own imports and dependencies still count) instead of ignored.
      "entry": ["**/*.{ios,android,native}.{ts,tsx}"],

      "ignoreDependencies": [
        // Declared on purpose in c5f9be9 ("so production builds embed the JS
        // bundle"): the @sentry/react-native/expo plugin shells out to it
        // during an EAS build. Nothing imports it, and nothing should.
        "@sentry/cli",

        // jest-expo's renderer reaches for this at runtime rather than
        // through an import, so dropping it turns every component test red.
        "react-test-renderer",

        // Inferred by knip's Expo plugin from app.json keys rather than from
        // any import: `userInterfaceStyle` implies expo-system-ui, the EAS
        // project id implies expo-updates. Neither is installed and the app
        // builds without them. Worth revisiting if Android ever ships, since
        // expo-system-ui is what applies `userInterfaceStyle` there.
        "expo-updates",
        "expo-system-ui"
      ]
    }
  },

  // The Supabase CLI is deliberately not a dependency: CI pins it with
  // supabase/setup-cli at 2.90.0 (newer versions break table grants, see
  // ci.yml) and locally it comes from npx. Declaring it in package.json would
  // give us a second version to keep in sync with that pin.
  //
  // `sips` is macOS's own image tool, shipped with the OS and never installable
  // from here. `scripts/walkthrough/build.mjs` uses it to downscale screenshots
  // and falls back to the full-size original when the call fails, so a machine
  // without it builds a heavier page rather than no page.
  "ignoreBinaries": ["supabase", "sips"]
}
