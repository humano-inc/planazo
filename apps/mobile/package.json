{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "lint": "eslint .",
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "expo": "expo",
    "test": "jest --forceExit --maxWorkers=3",
    "test:fast": "jest --forceExit --maxWorkers=3 --selectProjects lib",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@planazo/shared": "workspace:*",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@sentry/cli": "2.55.0",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.14",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~55.0.32",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "^55.0.17",
    "expo-dev-client": "~55.0.41",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "^55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "^55.0.18",
    "expo-screen-capture": "~55.0.18",
    "expo-secure-store": "^55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.23.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "lib",
        "preset": "jest-expo",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/lib/__tests__/**/*.test.ts?(x)"
        ]
      },
      {
        "displayName": "ui",
        "preset": "jest-expo",
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.js"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/lib/__tests__/"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!(\\.pnpm/)?(?:react-native|@react-native|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|native-base|react-native-svg|react-native-url-polyfill|@sentry(/|\\+)react-native))"
        ]
      }
    ]
  }
}
