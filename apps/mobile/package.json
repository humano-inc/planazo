{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "lint": "eslint .",
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "expo": "expo",
    "test": "jest --forceExit --maxWorkers=3",
    "test:fast": "jest --forceExit --maxWorkers=3 --selectProjects lib",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@planazo/shared": "workspace:*",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@sentry/cli": "3.8.0",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.89.0",
    "@tanstack/react-query": "^5.90.14",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "^58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "^58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "^58.0.30",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "^58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "lib",
        "preset": "jest-expo",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/lib/__tests__/**/*.test.ts?(x)"
        ]
      },
      {
        "displayName": "ui",
        "preset": "jest-expo",
        "resolver": "<rootDir>/lib/testing/jestResolver.js",
        "setupFilesAfterEnv": [
          "<rootDir>/jest.setup.js"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/lib/__tests__/"
        ],
        "transformIgnorePatterns": [
          "node_modules/(?!(\\.pnpm/)?(?:react-native|@react-native|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|native-base|react-native-svg|react-native-url-polyfill|@sentry(/|\\+)react-native|standard-navigation))"
        ]
      }
    ]
  }
}
